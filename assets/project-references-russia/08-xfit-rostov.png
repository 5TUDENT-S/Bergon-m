        $(this).parent().removeClass("error_input");
        if ($(this).val().length<3){
            validated = false;
            $(this).parent().addClass("error_input");
        }
    });
    return validated;
}
  
function submitForm_FORM10(form){
    $(form).find(".form-result").html('<div class="alert">Подождите..</div>');
    validated = validateForm_FORM10(form);
    if (validated==true){
        ym(33012779,'reachGoal','ask_about_product_form_submit');
        form_data = form.serialize();
        $.ajax({
            type: "POST",
            url: '/form-send.php',
            data: form_data,
            success: function(data){
                console.log(data);
                obj = JSON.parse(data);
                if (obj.result=="true"){
                    $(form).find("input, select, textarea").prop("disabled","true");
                    $(form).find(".form-result").show().html('<div class="alert alert-success">'+obj.message+'</div');
                    $(form).find(".btn").removeClass("submit-btn").text("Отправлено");
                }
                else{
                    $(form).find(".form-result").show().html('<div class="alert alert-error">'+obj.message+'</div');
                }
            },
            error: function(xhr, str){
                $(form).find(".form-result").show().html('<div class="alert alert-error">Возникла ошибка: '+xhr.responseCode+"</div>");
            }
        });
    }
    else{
        $(form).find(".form-result").show().html('<div class="alert alert-error">Ошибка заполнения формы</div>');
    }
}
</script></div>

