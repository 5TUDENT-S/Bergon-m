<script type="text/javascript">
    $(document).ready(function(){
        $('.vkr_news-content-app').slick({
            dots: false,
            infinite: true,
            speed: 300,
            slidesToShow: 1,
        });
		
		var count = 0;
		$( ".intro-cat-item" ).each(function() {
		var dataCat=$(this).attr('data-cat');
		
		var $thisParagraph = $( this );
		var count = 0;
		$thisParagraph.click(function() {
			console.log(dataCat);
			var index = dataCat-1;
			var linkDiv=$(document).find('.cat-item-links_'+index);
			var link = linkDiv.children(0).attr('href');
			count++;
			$thisParagraph.toggleClass( "highlight", count % 2 === 0 ); 
			if(count % 2==0){
				 document.location.href=link;
			}
		});
		});
    });
</script>

