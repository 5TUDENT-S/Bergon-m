<style>
.supermenu_block {
    font-family: 'PT Sans', sans-serif;
    color: #493230;
    font-size: 14px;
}
.supermenu_block a {
    text-decoration: none;
    line-height: 20px;
}
.supermenu_block h3 {
    font-size: 17px;
    font-weight: bold;
    margin: 15px 0 25px;
    color: #1d4264;
}
@media (max-width: 1300px) {
    .supermenu_block {
        font-size: 12px;
        margin: 10px 0 15px;
    }
    .supermenu_block h3 {
        font-size: 14px;
    }
    .supermenu_block a {
        line-height: 16px;
    }
}
.supermenu_table {
    display: flex;
    justify-content: flex-start;
    align-items: stretch;
    flex-wrap: nowrap;
    padding:20px 0 0;
}
.supermenu_table .column {
    padding:10px 30px;
    min-width:250px;
    max-width:300px;
    background: #fff;
    text-align: left;
}
@media (min-width: 1100px) {
    .supermenu_table .column {
        width:25%;
        min-width:25%;
        max-width:25%;
    }
}
.supermenu_table .column .item {
    margin:7px 0;
}
.supermenu_table .column:not(:last-child) {
    border-right: solid 1px #ccc;
}

.header-product-nav > ul {
    position: relative;
}
.header-product-nav > ul > li .supermenu_block {
    position: absolute;
    z-index: 100;
    left: 0;
    top: 35px;
    padding: 1px 0;
    width: 100%;
    min-width: 100%;
    text-align: left;
    margin: 0;
}
@media (min-width: 1124px) {
     .header-product-nav > ul > li .supermenu_block {
         display: none;
     }
}
@media (max-width: 1124px) {
    .header-product-nav > ul > li .supermenu_block {
        position: relative;
        left: 0;
        top: 0;
        padding:0;
        display: none;
    }
    .supermenu_table {
        display: block;
        padding:0;
    }
    .supermenu_table .column {
        padding:10px 30px;
        min-width:100%;
        max-width:100%;
    }
    .supermenu_block h3 {
        margin:0;
        position:relative;
    }
    .supermenu_block h3 i {
        position:absolute;
        right:0;
        top:0;
    }
    .supermenu_table .column .item {
        margin:15px 0;
    }
}
.header-product-nav > ul > li:nth-child(3) .supermenu_block .supermenu_table {
    justify-content: center;
}
.header-product-nav > ul > li:nth-child(4) .supermenu_block .supermenu_table {
    justify-content: flex-end;
}
@media (min-width: 1100px) {
    .header-product-nav > ul > li:hover .supermenu_block {
        display: block;
    }
}
</style> 

<script>
$(document).ready(function(){
    //if ($(window).width()>1100){
        super_menu = {};
        $(".supermenu_block").each(function(){
            code = $(this).data('code');
            super_menu[code] = $(this).html();
        });
        
        $(".header-product-nav > ul > li").each(function(){
            name = $(this).data('code');
            if (super_menu[name].length>15){
                $(this).find('a').after('<div class="supermenu_block">'+super_menu[name]+'</div>');
            }
        });
    //}
    if ($(window).width()<1100){
        $(".header-product-nav > ul > li").click(function(){
            child_menu = $(this).find(".supermenu_block");
            if (child_menu.hasClass("opened")){
                child_menu.removeClass("opened").hide();
                $(this).find("i").addClass("fa-chevron-right").removeClass("fa-chevron-down");
            }
            else{
                child_menu.addClass("opened").show();
                $(this).find("i").removeClass("fa-chevron-right").addClass("fa-chevron-down");
            }
        });
    }
});
</script></body>
</html>
