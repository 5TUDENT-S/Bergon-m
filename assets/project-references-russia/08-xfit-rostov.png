<script type="text/javascript">
    $(".header-callback").click(function(){
        $("#myPopupBg").show();
        $("#myPopupHeadBlock").show();
    });
    $(".myPopupHeadBlockClose").click(function(){
        $("#myPopupBg").hide();
        $("#myPopupHeadBlock").hide();
    });
    
    $(".spec-question2").click(function(){
        text = $(this).data("text");
        if (text.length>0){
            $("#myPopupHeadBlock2 textarea").val(text);
        }
        $("#myPopupBg").show();
        $("#myPopupHeadBlock2").show();
    });
    $(".myPopupHeadBlockClose").click(function(){
        $("#myPopupBg").hide();
        $("#myPopupHeadBlock2").hide();
    });
    
    $(".calc-callback").click(function(){
        $("#myPopupBg").show();
        $("#myPopupHeadBlock3").show();
    });
    $(".myPopupHeadBlockClose").click(function(){
        $("#myPopupBg").hide();
        $("#myPopupHeadBlock3").hide();
    });
    
    $(document).mouseup(function(e){
        var div = $(".popup_header");
        if (!div.is(e.target) && div.has(e.target).length === 0){ 
          $("#myPopupBg").hide();
          $(".popup_header").hide();
        }
    });

    if($(window).width() < '768') {
        $('.filters-column-title').on('click', function() {
            if($(this).hasClass('active')) {
                $(this).siblings('.filters-column-list').slideUp(400);
                //$(this).removeClass('active');
		$("filters-column-title").removeClass('active');
            } else {
                //$('.nav-links-list').slideUp(400);
		$("filters-column-title").addClass('active');
		//$(this).addClass('active');
                $(this).siblings('.filters-column-list').slideDown(400);
            }
        });

        $('.form-trigger').on('click', function() {
            if($(this).hasClass('active')) {
		$('.filters-block').slideUp(400);
                $(this).closest('.filters-block').slideUp(400);
                $(this).removeClass('active');
            } else {
		$('.filters-block').slideDown(400);
                $(this).addClass('active');
                $(this).closest('.filters-block').slideDown(400);
            }
        });

        $('.sidebar-trigger').on('click', function() {
            if($(this).hasClass('active')) {
                $(this).siblings('.sidebar-subject').slideUp(400);
                //$(this).removeClass('active');
				$("sidebar-trigger").removeClass('active');
            } else {
                //$(this).addClass('active');
				$("sidebar-trigger").addClass('active');
                $(this).siblings('.sidebar-subject').slideDown(400);
            }
        });

    } else {

        $('.form-trigger').on('click', function() {
            if($(this).hasClass('active')) {
                $(this).closest('.search-form').find('.filters-column-list').slideUp(400);
                $(this).closest('.search-form').find('.clear-products-block').removeClass('active');
                $(this).removeClass('active');
            } else {
                $(this).addClass('active');
                $(this).closest('.search-form').find('.filters-column-list').slideDown(400);
                $(this).closest('.search-form').find('.clear-products-block').addClass('active');
            }
        });
    }

    $(".dealers-tab").click(function(){
        showTab($(this).index(),'dealers-tab','dealers-content-item');
    });
    showTab(0,'dealers-tab','dealers-content-item');

	

    $(".docs-tab").click(function(){
        showTab($(this).index(),'docs-tab','calculator-forms-item');
    });
    showTab(0,'docs-tab','calculator-forms-item');

    $(".calculator-tabs-item").click(function(){
        showTab($(this).index(),'calculator-tabs-item','calculator-forms-item');
    });
    showTab(0,'calculator-tabs-item','calculator-forms-item');

    $(".calculator-tabs-item2").click(function(){
        showTab($(this).index(),'calculator-tabs-item2','ventfasad-calculation-container');
    });
    showTab(0,'calculator-tabs-item2','ventfasad-calculation-container');

    $(".contacts-tab-item").click(function(){
        showTab($(this).index(),'contacts-tab-item','contacts-content-item');
    });
    showTab(0,'contacts-tab-item','contacts-content-item');

    $('table').wrap('<div class="overlay-table"></div>');
    $('.result-block').wrap('<div class="overlay-table"></div>');
    
    $(".subscribe-modal .close-btn").on("click", function(){
        $.ajax({
            type: "POST",
            url: "/local/templates/furniture_dark-blue/accept-subscribe.php",
            data: "accept=1",
            success: function(data){
                $(".subscribe-modal").fadeOut();      
            }
        });
    });
    
    $(".cookie-alert .button").on("click", function(){
        $.ajax({
            type: "POST",
            url: "/local/templates/furniture_dark-blue/accept-cookie.php",
            data: "accept=1",
            success: function(data){
                $(".cookie-alert").fadeOut();
            }
        });
    });
    
    function showTab(index,tab,block){
        $("."+tab+"").removeClass("active");
        $("."+tab+":eq("+index+")").addClass("active");
        $("."+block+" *").removeAttr("style");
        $("."+block+"").hide()
        $("."+block+":eq("+index+")").fadeIn();
    }
    
    $(window).scroll(function(){ 
        //if ($(window).width()>950){
            if ($(this).scrollTop()>800){
                $(".gototop-btn").show();
            }
            else{
                $(".gototop-btn").hide();
            }
        //}
    });
    
    $(".gototop-btn").click(function(){
        $("html, body").animate({scrollTop: "0"});
    });
</script>

